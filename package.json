{
  "name": "clinica-eqlive",
  "version": "1.0.0",
  "description": "Website da Clínica Eqlive - Medicina Integrativa e Funcional",
  "main": "src/index.html",
  "scripts": {
    "start": "open src/index.html",
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/css/tailwind.css -o ./src/css/tailwind.generated.css --minify",
    "dev:css": "tailwindcss -c tailwind.config.js -i ./src/css/tailwind.css -o ./src/css/tailwind.generated.css --watch",
    "build": "npm run build:css"
  },
  "keywords": [
    "medicina",
    "funcional",
    "integrativa",
    "saúde",
    "clínica"
  ],
  "author": "Christyan Bernardo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/seu-usuario/clinica-eqlive.git"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  },
  "dependencies": {}
}
